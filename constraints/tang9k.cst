// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) pin constraints for top_tang9k
// Clock bank is 3.3 V; the onboard LEDs and buttons sit on bank 3, which runs at 1.8 V.
// GPIO ports A and C use 3.3 V header pins; GPIO port B is on the 1.8 V bank.

// 27 MHz board clock
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// S1 reset button (low when pressed)
IO_LOC  "btn_rst_n" 4;
IO_PORT "btn_rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// LEDs (active-low)
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;

// GPIO port C (PINC 0x87, PORTC 0x88, DDRC 0x89), internal pull-up
// Left header row, positions 9-16, right below port A, bit 0 at the top
IO_LOC  "gpio_c[0]" 29;  IO_PORT "gpio_c[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_c[1]" 30;  IO_PORT "gpio_c[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_c[2]" 33;  IO_PORT "gpio_c[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_c[3]" 34;  IO_PORT "gpio_c[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_c[4]" 40;  IO_PORT "gpio_c[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_c[5]" 35;  IO_PORT "gpio_c[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_c[6]" 41;  IO_PORT "gpio_c[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_c[7]" 42;  IO_PORT "gpio_c[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Pins 51, 53, 54, 55 (left row, positions 17-20) are free

// GPIO port A (PINA 0x80, PORTA 0x82, DDRA 0x83), internal pull-up
// Top 8 pins of the left header row, bit 0 at the top (pins 36-39 are shared with the TF card slot: leave it empty)
// Buttons wired to GND read 0 when pressed. Put ~330 ohm in series with each button,
// so a pin set as an output driving 1 cannot short to GND.
IO_LOC  "gpio_a[0]" 38;  IO_PORT "gpio_a[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_a[1]" 37;  IO_PORT "gpio_a[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_a[2]" 36;  IO_PORT "gpio_a[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_a[3]" 39;  IO_PORT "gpio_a[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_a[4]" 25;  IO_PORT "gpio_a[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_a[5]" 26;  IO_PORT "gpio_a[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_a[6]" 27;  IO_PORT "gpio_a[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_a[7]" 28;  IO_PORT "gpio_a[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// GPIO port B (PINB 0x84, PORTB 0x85, DDRB 0x86), internal pull-up
// Pins 79-86 are on bank 3, which runs at 1.8 V (like the onboard LEDs and buttons): port B is a 1.8 V port.
// Pins 68-75 are avoided (shared with HDMI), as are 17/18 (USB-UART, kept free for later).
IO_LOC  "gpio_b[0]" 79;  IO_PORT "gpio_b[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_b[1]" 80;  IO_PORT "gpio_b[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_b[2]" 81;  IO_PORT "gpio_b[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_b[3]" 82;  IO_PORT "gpio_b[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_b[4]" 83;  IO_PORT "gpio_b[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_b[5]" 84;  IO_PORT "gpio_b[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_b[6]" 85;  IO_PORT "gpio_b[6]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "gpio_b[7]" 86;  IO_PORT "gpio_b[7]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
