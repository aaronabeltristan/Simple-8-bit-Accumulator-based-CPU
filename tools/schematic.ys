read_verilog rtl/core/cpu.v rtl/core/program_counter.v rtl/core/instruction_register.v rtl/core/instruction_decoder.v
read_verilog rtl/core/control_unit.v rtl/core/nto1mux.v rtl/core/alu.v rtl/core/accumulator.v rtl/core/flag_register.v
read_verilog rtl/memory/instruction_memory.v rtl/memory/data_bus.v rtl/memory/data_memory.v
read_verilog rtl/periph/gpio.v rtl/periph/synchronizer.v rtl/periph/clock_divider.v rtl/board/top_tang9k.v
chparam -set PROGRAM "programs/1sec_countdown.hex" top_tang9k
hierarchy -top cpu
proc
tribuf
opt
write_json cpu.json